import QseriesFormalization.Pending.Chapter10_M3_PairBoundary
import QseriesFormalization.Pending.Chapter10_M3_OmegaKernel

/-!
# Hecke-side normal form for `Fhm * BY * BX`

This file expands the coefficient of the triple product

  `coeffQXY (Fhm * BY * BX) e x y`

through the concrete product `SummableFamily` generated by

  `FhmFamily`, `mhatThetaFamily 90 18 (-2) 2`, and
  `mhatThetaFamily 90 (-18) 2 (-2)`.

The product index is `(((r,s),p),q)`.  The final normal form uses
`u = p`, `v = q - p`, hence `q = u + v`, and the fixed `x,y` coefficient
constraints pin the Hecke indices to

  `r = x - 2*v`, `s = y + 2*v`.
-/

open scoped Classical
open Set

namespace QseriesFormalization.Pending.Ch10M3Ghat

open QseriesFormalization.Ch10TwoVar
open QseriesFormalization.Pending.Ch10HM
open QseriesFormalization.Pending.Ch10M3Mhat
open QseriesFormalization.Pending.Ch10M3HMf
open QseriesFormalization.Pending.Ch10M3OmegaKernel

noncomputable section

/-- Q-degree of the `B_Y = j(Q^18 x^-2 y^2;Q^90)` theta term at index `p`. -/
def BYExp (p : ℤ) : ℤ :=
  45 * p * (p - 1) + 18 * p

/-- Q-degree of the `B_X = j(Q^-18 x^2 y^-2;Q^90)` theta term at index `q`. -/
def BXExp (q : ℤ) : ℤ :=
  45 * q * (q - 1) - 18 * q

/-- One `B_Y` theta monomial. -/
noncomputable def BYTerm (p : ℤ) : S :=
  monom (BYExp p) (-2 * p) (2 * p) (negOnePowIntQ p)

/-- One `B_X` theta monomial. -/
noncomputable def BXTerm (q : ℤ) : S :=
  monom (BXExp q) (2 * q) (-2 * q) (negOnePowIntQ q)

/-- The concrete summable family for `B_Y`. -/
private noncomputable abbrev BYFamily : HahnSeries.SummableFamily ExpQXY ℚ ℤ :=
  mhatThetaFamily 90 18 (-2) 2 (by norm_num)

/-- The concrete summable family for `B_X`. -/
private noncomputable abbrev BXFamily : HahnSeries.SummableFamily ExpQXY ℚ ℤ :=
  mhatThetaFamily 90 (-18) 2 (-2) (by norm_num)

/-- The concrete product family whose `hsum` is `(Fhm * BY) * BX`. -/
private noncomputable abbrev FhmBYBXFamily :
    HahnSeries.SummableFamily ExpQXY ℚ (((ℤ × ℤ) × ℤ) × ℤ) :=
  (FhmFamily.mul BYFamily).mul BXFamily

/-- The raw four-index Hecke-side coefficient contribution. -/
def FhmBYBX_rawCoeff (e x y r s p q : ℤ) : ℚ :=
  if e = FhmExp r s + BYExp p + BXExp q ∧
      x = r - 2 * p + 2 * q ∧
      y = s + 2 * p - 2 * q then
    FhmCoeff r s * negOnePowIntQ p * negOnePowIntQ q
  else
    0

/--
The pinned coefficient after solving the `x,y` constraints:
`r = x + 2p - 2q`, `s = y - 2p + 2q`.
-/
def FhmBYBX_pinnedCoeff (e x y p q : ℤ) : ℚ :=
  let r := x + 2 * p - 2 * q
  let s := y - 2 * p + 2 * q
  if e = FhmExp r s + BYExp p + BXExp q then
    FhmCoeff r s * negOnePowIntQ p * negOnePowIntQ q
  else
    0

/--
The final `(u,v)` normal form, with `u = p`, `v = q-p`, hence `q = u+v`.
The Hecke indices are `r = x - 2v`, `s = y + 2v`.
-/
def FhmBYBX_uvCoeff (e x y u v : ℤ) : ℚ :=
  let r := x - 2 * v
  let s := y + 2 * v
  let q := u + v
  if e = FhmExp r s + BYExp u + BXExp q then
    FhmCoeff r s * negOnePowIntQ u * negOnePowIntQ q
  else
    0

/--
The same coefficient with the Hecke cone coefficient exposed as the same-sign
indicator `sg`.  The theta signs contribute `(-1)^v`, because
`(-1)^u*(-1)^(u+v)=(-1)^v`.
-/
def FhmBYBX_uvOmegaCoeff (e x y u v : ℤ) : ℚ :=
  let r := x - 2 * v
  let s := y + 2 * v
  let q := u + v
  if e = FhmExp r s + BYExp u + BXExp q then
    negOnePowIntQ (x + y + v) * (((sg r s : ℤ) : ℚ))
  else
    0

/-! ## Product-index `finsum` wrappers -/

/-- If a finitely supported function on a product is summed in the right coordinate,
the resulting left-coordinate function is finitely supported. -/
private theorem support_finsum_prod_left_finite {α β : Type*} {f : α × β → ℚ}
    (hf : (Function.support f).Finite) :
    (Function.support (fun a : α => ∑ᶠ b : β, f (a, b))).Finite := by
  classical
  refine Set.Finite.subset (hf.image (fun p : α × β => p.1)) ?_
  intro a ha
  simp only [Function.mem_support] at ha
  by_contra hmem
  have hzero : ∀ b : β, f (a, b) = 0 := by
    intro b
    by_contra hb
    apply hmem
    refine ⟨(a, b), ?_, rfl⟩
    simpa [Function.mem_support] using hb
  exact ha (finsum_eq_zero_of_forall_eq_zero hzero)

/-- Curry a finitely supported four-product sum in the concrete association
`(((a,b),c),d)`.  This is the product-finsum support wrapper needed for the
triple `SummableFamily.mul` product. -/
private theorem finsum_four_prod_curry {α β γ δ : Type*}
    {f : ((α × β) × γ) × δ → ℚ}
    (hf : (Function.support f).Finite) :
    (∑ᶠ idx : ((α × β) × γ) × δ, f idx) =
      ∑ᶠ a : α, ∑ᶠ b : β, ∑ᶠ c : γ, ∑ᶠ d : δ,
        f (((a, b), c), d) := by
  classical
  rw [finsum_curry _ hf]
  let g : (α × β) × γ → ℚ := fun x => ∑ᶠ d : δ, f (x, d)
  change (∑ᶠ x : (α × β) × γ, g x) = _
  have hg : (Function.support g).Finite :=
    support_finsum_prod_left_finite (f := f) hf
  rw [finsum_curry _ hg]
  let h : α × β → ℚ := fun ab => ∑ᶠ c : γ, g (ab, c)
  change (∑ᶠ ab : α × β, h ab) = _
  have hh : (Function.support h).Finite :=
    support_finsum_prod_left_finite (f := g) hg
  rw [finsum_curry _ hh]

/-- Reorder a finitely supported four-index sum from `(r,s,p,q)` to `(p,q,r,s)`. -/
private theorem finsum_four_reorder_rs_pq
    (f : ℤ → ℤ → ℤ → ℤ → ℚ)
    (hf : (Function.support (fun idx : ((ℤ × ℤ) × ℤ) × ℤ =>
      f idx.1.1.1 idx.1.1.2 idx.1.2 idx.2)).Finite) :
    (∑ᶠ r : ℤ, ∑ᶠ s : ℤ, ∑ᶠ p : ℤ, ∑ᶠ q : ℤ, f r s p q) =
      ∑ᶠ p : ℤ, ∑ᶠ q : ℤ, ∑ᶠ r : ℤ, ∑ᶠ s : ℤ, f r s p q := by
  classical
  let fold : ((ℤ × ℤ) × ℤ) × ℤ → ℚ :=
    fun idx => f idx.1.1.1 idx.1.1.2 idx.1.2 idx.2
  let e : ((ℤ × ℤ) × ℤ) × ℤ ≃ ((ℤ × ℤ) × ℤ) × ℤ :=
    { toFun := fun idx => (((idx.1.2, idx.2), idx.1.1.1), idx.1.1.2)
      invFun := fun idx => (((idx.1.2, idx.2), idx.1.1.1), idx.1.1.2)
      left_inv := fun idx => by rcases idx with ⟨⟨⟨p, q⟩, r⟩, s⟩; rfl
      right_inv := fun idx => by rcases idx with ⟨⟨⟨r, s⟩, p⟩, q⟩; rfl }
  have hnew : (Function.support (fun idx : ((ℤ × ℤ) × ℤ) × ℤ => fold (e idx))).Finite := by
    refine Set.Finite.subset (hf.image (fun idx : ((ℤ × ℤ) × ℤ) × ℤ => e.symm idx)) ?_
    intro idx hidx
    simp only [Function.mem_support] at hidx
    refine ⟨e idx, ?_, ?_⟩
    · simpa [fold, Function.mem_support] using hidx
    · simpa using e.symm_apply_apply idx
  calc
    (∑ᶠ r : ℤ, ∑ᶠ s : ℤ, ∑ᶠ p : ℤ, ∑ᶠ q : ℤ, f r s p q)
        = ∑ᶠ idx : ((ℤ × ℤ) × ℤ) × ℤ, fold idx := by
          symm
          exact finsum_four_prod_curry (f := fold) hf
    _ = ∑ᶠ idx : ((ℤ × ℤ) × ℤ) × ℤ, fold (e idx) := by
          exact (show (∑ᶠ idx : ((ℤ × ℤ) × ℤ) × ℤ, fold idx) =
              ∑ᶠ idx : ((ℤ × ℤ) × ℤ) × ℤ, fold (e idx) from
            (finsum_comp_equiv e).symm)
    _ = ∑ᶠ p : ℤ, ∑ᶠ q : ℤ, ∑ᶠ r : ℤ, ∑ᶠ s : ℤ, f r s p q := by
          rw [finsum_four_prod_curry (f := fun idx : ((ℤ × ℤ) × ℤ) × ℤ => fold (e idx)) hnew]
          rfl

/-! ## Monomial evaluation for the triple product family -/

/-- Pointwise coefficient evaluation of one product-family term. -/
private theorem FhmBYBXFamily_coeff_eq_raw (e x y r s p q : ℤ) :
    (FhmBYBXFamily (((r, s), p), q)).coeff (expQXY e x y) =
      FhmBYBX_rawCoeff e x y r s p q := by
  show (monom (FhmExp r s) r s (FhmCoeff r s) *
        monom (thetaQDeg 90 18 p) (-2 * p) (2 * p) (negOnePowIntQ p) *
        monom (thetaQDeg 90 (-18) q) (2 * q) (-2 * q) (negOnePowIntQ q)).coeff (expQXY e x y)
      = FhmBYBX_rawCoeff e x y r s p q
  rw [thetaQDeg_90, thetaQDeg_90, monom_mul, monom_mul]
  unfold monom FhmBYBX_rawCoeff BYExp BXExp
  rw [HahnSeries.coeff_single, expQXY_eq_iff]
  by_cases h : e = FhmExp r s + (45 * p * (p - 1) + 18 * p) + (45 * q * (q - 1) - 18 * q) ∧
      x = r - 2 * p + 2 * q ∧ y = s + 2 * p - 2 * q
  · obtain ⟨he, hx, hy⟩ := h
    rw [if_pos (show _ ∧ _ ∧ _ from ⟨by rw [he]; ring, by omega, by omega⟩),
        if_pos (⟨he, hx, hy⟩)]
  · rw [if_neg (fun hL => h ⟨by rw [hL.1]; ring, by omega, by omega⟩), if_neg h]

theorem FhmBYBX_rawCoeff_support_finite (e x y : ℤ) :
    (Function.support (fun idx : ((ℤ × ℤ) × ℤ) × ℤ =>
      FhmBYBX_rawCoeff e x y idx.1.1.1 idx.1.1.2 idx.1.2 idx.2)).Finite := by
  have hf : (Function.support (fun idx : ((ℤ × ℤ) × ℤ) × ℤ =>
      (FhmBYBXFamily idx).coeff (expQXY e x y))).Finite :=
    FhmBYBXFamily.finite_co_support' (expQXY e x y)
  apply hf.subset
  intro idx hidx
  rcases idx with ⟨⟨⟨r, s⟩, p⟩, q⟩
  rw [Function.mem_support] at hidx ⊢
  rw [FhmBYBXFamily_coeff_eq_raw]
  exact hidx

theorem FhmBYBX_rawCoeff_uv_eq_uvCoeff (e x y u v : ℤ) :
    FhmBYBX_rawCoeff e x y (x - 2 * v) (y + 2 * v) u (u + v) =
      FhmBYBX_uvCoeff e x y u v := by
  unfold FhmBYBX_rawCoeff FhmBYBX_uvCoeff
  have hx : x = (x - 2 * v) - 2 * u + 2 * (u + v) := by ring
  have hy : y = (y + 2 * v) + 2 * u - 2 * (u + v) := by ring
  by_cases hE : e = FhmExp (x - 2 * v) (y + 2 * v) + BYExp u + BXExp (u + v)
  · rw [if_pos hE, if_pos ⟨hE, hx, hy⟩]
  · rw [if_neg hE, if_neg]
    intro h
    exact hE h.1

/-! ## Raw coefficient expansion -/

/-- The raw expansion of the Hecke side as a four-index finsum. -/
theorem coeff_Fhm_BY_BX_raw (e x y : ℤ) :
    coeffQXY (Fhm * BY * BX) e x y =
      ∑ᶠ r : ℤ, ∑ᶠ s : ℤ, ∑ᶠ p : ℤ, ∑ᶠ q : ℤ,
        FhmBYBX_rawCoeff e x y r s p q := by
  classical
  unfold BY BX ghatBoundary Fhm
  change coeffQXY (FhmFamily.hsum * BYFamily.hsum * BXFamily.hsum) e x y =
      ∑ᶠ r : ℤ, ∑ᶠ s : ℤ, ∑ᶠ p : ℤ, ∑ᶠ q : ℤ,
        FhmBYBX_rawCoeff e x y r s p q
  rw [← HahnSeries.SummableFamily.hsum_mul]
  rw [← HahnSeries.SummableFamily.hsum_mul]
  unfold coeffQXY
  rw [HahnSeries.SummableFamily.coeff_hsum]
  change
    (∑ᶠ idx : ((ℤ × ℤ) × ℤ) × ℤ,
      (FhmBYBXFamily idx).coeff (expQXY e x y))
    =
      ∑ᶠ r : ℤ, ∑ᶠ s : ℤ, ∑ᶠ p : ℤ, ∑ᶠ q : ℤ,
        FhmBYBX_rawCoeff e x y r s p q
  rw [finsum_four_prod_curry
    (f := fun idx : ((ℤ × ℤ) × ℤ) × ℤ =>
      (FhmBYBXFamily idx).coeff (expQXY e x y))
    (FhmBYBXFamily.finite_co_support' (expQXY e x y))]
  apply finsum_congr
  intro r
  apply finsum_congr
  intro s
  apply finsum_congr
  intro p
  apply finsum_congr
  intro q
  exact FhmBYBXFamily_coeff_eq_raw e x y r s p q

/-! ## Pinning the Hecke indices -/

/-- For fixed `p,q`, the `x,y` constraints uniquely pin `r,s`. -/
private theorem raw_rs_sum_eq_pinned (e x y p q : ℤ) :
    (∑ᶠ r : ℤ, ∑ᶠ s : ℤ, FhmBYBX_rawCoeff e x y r s p q) =
      FhmBYBX_pinnedCoeff e x y p q := by
  classical
  let r0 : ℤ := x + 2 * p - 2 * q
  let s0 : ℤ := y - 2 * p + 2 * q
  have hsupportR :
      Function.support (fun r : ℤ => ∑ᶠ s : ℤ, FhmBYBX_rawCoeff e x y r s p q) ⊆
        ↑({r0} : Finset ℤ) := by
    intro r hr
    simp only [Function.mem_support] at hr
    simp only [Finset.coe_singleton, Set.mem_singleton_iff]
    by_contra hne
    have hzero : (∑ᶠ s : ℤ, FhmBYBX_rawCoeff e x y r s p q) = 0 := by
      apply finsum_eq_zero_of_forall_eq_zero
      intro s
      unfold FhmBYBX_rawCoeff
      rw [if_neg]
      intro h
      rcases h with ⟨he, hx, hy⟩
      apply hne
      dsimp [r0]
      omega
    exact hr hzero
  rw [finsum_eq_finsetSum_of_support_subset _ hsupportR]
  simp only [Finset.sum_singleton]
  have hsupportS :
      Function.support (fun s : ℤ => FhmBYBX_rawCoeff e x y r0 s p q) ⊆
        ↑({s0} : Finset ℤ) := by
    intro s hsupp
    simp only [Function.mem_support] at hsupp
    simp only [Finset.coe_singleton, Set.mem_singleton_iff]
    by_contra hne
    have hzero : FhmBYBX_rawCoeff e x y r0 s p q = 0 := by
      unfold FhmBYBX_rawCoeff
      rw [if_neg]
      intro h
      rcases h with ⟨he, hx, hy⟩
      apply hne
      dsimp [s0]
      omega
    exact hsupp hzero
  rw [finsum_eq_finsetSum_of_support_subset _ hsupportS]
  simp only [Finset.sum_singleton]
  dsimp [r0, s0]
  unfold FhmBYBX_rawCoeff FhmBYBX_pinnedCoeff
  have hx : x = (x + 2 * p - 2 * q) - 2 * p + 2 * q := by ring
  have hy : y = (y - 2 * p + 2 * q) + 2 * p - 2 * q := by ring
  by_cases hE : e = FhmExp (x + 2 * p - 2 * q) (y - 2 * p + 2 * q) +
      BYExp p + BXExp q
  · rw [if_pos hE]
    rw [if_pos ⟨hE, hx, hy⟩]
  · rw [if_neg hE]
    rw [if_neg]
    intro h
    exact hE h.1

/-- Collapse the raw four-index sum to the pinned `(p,q)` sum. -/
theorem coeff_Fhm_BY_BX_pinned (e x y : ℤ) :
    coeffQXY (Fhm * BY * BX) e x y =
      ∑ᶠ p : ℤ, ∑ᶠ q : ℤ,
        FhmBYBX_pinnedCoeff e x y p q := by
  classical
  rw [coeff_Fhm_BY_BX_raw]
  rw [finsum_four_reorder_rs_pq
    (fun r s p q => FhmBYBX_rawCoeff e x y r s p q)
    (FhmBYBX_rawCoeff_support_finite e x y)]
  apply finsum_congr
  intro p
  apply finsum_congr
  intro q
  exact raw_rs_sum_eq_pinned e x y p q

/-! ## Reindex `(p,q)` to `(u,v)` -/

/-- Reindex the pinned `(p,q)` sum to `(u,v)` with `u=p`, `v=q-p`. -/
theorem coeff_Fhm_BY_BX_uv (e x y : ℤ) :
    coeffQXY (Fhm * BY * BX) e x y =
      ∑ᶠ u : ℤ, ∑ᶠ v : ℤ,
        FhmBYBX_uvCoeff e x y u v := by
  classical
  rw [coeff_Fhm_BY_BX_pinned]
  apply finsum_congr
  intro u
  rw [show
      (∑ᶠ q : ℤ, FhmBYBX_pinnedCoeff e x y u q) =
        ∑ᶠ v : ℤ, FhmBYBX_pinnedCoeff e x y u (v + u) from
      (finsum_comp_equiv (Equiv.addRight u)).symm]
  apply finsum_congr
  intro v
  unfold FhmBYBX_pinnedCoeff FhmBYBX_uvCoeff
  have hq : v + u = u + v := by ring
  rw [hq]
  have hr : x + 2 * u - 2 * (u + v) = x - 2 * v := by ring
  have hs : y - 2 * u + 2 * (u + v) = y + 2 * v := by ring
  rw [hr, hs]

/-! ## Exposing `sg` -/

/-- `FhmCoeff` is `(-1)^(r+s)` times the same-sign indicator `sg`. -/
theorem FhmCoeff_eq_negpow_mul_sg (r s : ℤ) :
    FhmCoeff r s =
      negOnePowIntQ (r + s) * (((sg r s : ℤ) : ℚ)) := by
  unfold FhmCoeff sg
  by_cases hr : 0 ≤ r <;> by_cases hs : 0 ≤ s
  · rw [if_pos ⟨hr, hs⟩, if_pos ⟨hr, hs⟩]; push_cast; ring
  · rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega)]; push_cast; ring
  · rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega)]; push_cast; ring
  · rw [if_neg (by omega), if_pos (by omega), if_neg (by omega), if_pos (by omega)]; push_cast; ring

/-- The boundary theta signs reduce to `(-1)^v`. -/
private theorem theta_boundary_sign_uv (u v : ℤ) :
    negOnePowIntQ u * negOnePowIntQ (u + v) = negOnePowIntQ v := by
  rw [← negOnePowIntQ_add]
  rw [show u + (u + v) = v + 2 * u by ring]
  rw [negOnePowIntQ_add]
  have heven : negOnePowIntQ (2 * u) = 1 := by
    rw [negOnePowIntQ_eq_negOnePow]
    simp [Int.negOnePow_two_mul]
  rw [heven]
  ring

/-- Rewrite the `uv` coefficient using the same-sign kernel. -/
theorem FhmBYBX_uvCoeff_eq_omegaRaw (e x y u v : ℤ) :
    FhmBYBX_uvCoeff e x y u v =
      FhmBYBX_uvOmegaCoeff e x y u v := by
  classical
  unfold FhmBYBX_uvCoeff FhmBYBX_uvOmegaCoeff
  by_cases hE :
      e = FhmExp (x - 2 * v) (y + 2 * v) + BYExp u + BXExp (u + v)
  · rw [if_pos hE, if_pos hE]
    rw [FhmCoeff_eq_negpow_mul_sg]
    have hsum : (x - 2 * v) + (y + 2 * v) = x + y := by ring
    rw [hsum]
    calc
      negOnePowIntQ (x + y) * (((sg (x - 2 * v) (y + 2 * v) : ℤ) : ℚ)) *
            negOnePowIntQ u * negOnePowIntQ (u + v)
          = (negOnePowIntQ (x + y) *
              (negOnePowIntQ u * negOnePowIntQ (u + v))) *
              (((sg (x - 2 * v) (y + 2 * v) : ℤ) : ℚ)) := by ring
      _ = (negOnePowIntQ (x + y) * negOnePowIntQ v) *
              (((sg (x - 2 * v) (y + 2 * v) : ℤ) : ℚ)) := by
            rw [theta_boundary_sign_uv]
      _ = negOnePowIntQ (x + y + v) *
              (((sg (x - 2 * v) (y + 2 * v) : ℤ) : ℚ)) := by
            rw [← negOnePowIntQ_add]
  · rw [if_neg hE, if_neg hE]

theorem FhmBYBX_uvOmegaCoeff_support_finite (e x y : ℤ) :
    (Function.support (fun uv : ℤ × ℤ =>
      FhmBYBX_uvOmegaCoeff e x y uv.1 uv.2)).Finite := by
  classical
  let emb : ℤ × ℤ → ((ℤ × ℤ) × ℤ) × ℤ :=
    fun uv => ((((x - 2 * uv.2), (y + 2 * uv.2)), uv.1), uv.1 + uv.2)
  have hemb : Function.Injective emb := by
    intro uv₁ uv₂ h
    rcases uv₁ with ⟨u₁, v₁⟩
    rcases uv₂ with ⟨u₂, v₂⟩
    have hu : u₁ = u₂ := congrArg (fun z : ((ℤ × ℤ) × ℤ) × ℤ => z.1.2) h
    have hq : u₁ + v₁ = u₂ + v₂ := congrArg (fun z : ((ℤ × ℤ) × ℤ) × ℤ => z.2) h
    ext <;> omega
  have hraw := FhmBYBX_rawCoeff_support_finite e x y
  refine Set.Finite.subset
    (hraw.preimage (Set.injOn_of_injective hemb)) ?_
  intro uv huv
  rw [Function.mem_support] at huv
  rw [Set.mem_preimage, Function.mem_support]
  rcases uv with ⟨u, v⟩
  dsimp [emb]
  rw [FhmBYBX_rawCoeff_uv_eq_uvCoeff, FhmBYBX_uvCoeff_eq_omegaRaw]
  exact huv

/--
Hecke side as an explicit `u`-theta by `v`-same-sign-line double sum.
-/
theorem coeffQXY_Fhm_BY_BX_uvOmega (e x y : ℤ) :
    coeffQXY (Fhm * BY * BX) e x y =
      ∑ᶠ u : ℤ, ∑ᶠ v : ℤ, FhmBYBX_uvOmegaCoeff e x y u v := by
